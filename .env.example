# Copy to .env (git-ignored) or export in your shell. NEVER commit real values.
# Aurum reads secrets from the environment only — never from YAML configs.

# --- LLM trading desk (aurum desk run / replay, live.use_desk) ---
ANTHROPIC_API_KEY=

# --- MetaTrader 5 (Windows only; aurum live run with live.broker: mt5) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# --- Optional alerting (aurum.live.monitor) ---
AURUM_ALERT_WEBHOOK_URL=
AURUM_ALERT_TELEGRAM_CHAT_ID=

# --- Optional: HMAC key that signs/verifies pickled live artifacts ---
AURUM_ARTIFACT_KEY=
